# Single place to bump release versions (sourced by motadata_packaging.sh and docs).
# After editing, run: ./scripts/motadata_packaging.sh sync-versions
#
# Context Layer wheel (packaging/motadata-context-layer/pyproject.toml)
export MOTADATA_CONTEXT_LAYER_VERSION="${MOTADATA_CONTEXT_LAYER_VERSION:-0.1.4}"
# JetBrains plugin (jetbrains-plugin/build.gradle.kts + META-INF/plugin.xml)
export MOTADATA_JETBRAINS_PLUGIN_VERSION="${MOTADATA_JETBRAINS_PLUGIN_VERSION:-0.2.7}"
