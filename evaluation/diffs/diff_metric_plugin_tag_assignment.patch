+    private JsonArray getObjectsByEntityType(String entityType, JsonArray entityIds)
+    {
+        if (entityType.equalsIgnoreCase(APIConstants.Entity.GROUP.getName()))
+        {
+            return ObjectConfigStore.getStore().getItemsByGroups(entityIds);
+        }
+        else if (entityType.equalsIgnoreCase(APIConstants.Entity.TAG.getName()))
+        {
+            return ObjectConfigStore.getStore().getIdsByTags(entityIds);
