+    /**
+     * Handles object updates by checking for removed tags/groups and unprovisioning associated metrics
+     */
+    private void handleObjectUpdate(JsonObject currentObject, JsonObject event)
+    {
+        if (currentObject == null)
+        {
+            vertx.eventBus().send(replyTopic, event);
+
+            return;
+        }
+
+        // Unprovision metrics for removed tags/groups
+        unprovisionMetrics(currentObject).onComplete(result ->
+        {
+            // After unprovisioning, proceed with normal metric assignment
+            assignMetricPlugin(currentObject, event);
+        });
+    }
+
+    /**
+     * Unprovisions metrics that were assigned via removed tags or groups
+     */
+    private Future<Void> unprovisionMetrics(JsonObject object)
+    {
+        var promise = Promise.<Void>promise();
+
+        var metrics = new ArrayList<JsonObject>();
+
+        try
+        {
+            var objectId = object.getLong(ID);
+
+            // Find metrics assigned to this object
+            for (var metric : MetricConfigStore.getStore().getItemsByObject(objectId))
+            {
+                var context = metric.getJsonObject(Metric.METRIC_CONTEXT);
+
+                if (context != null && context.containsKey(APIConstants.ENTITY_ID))
+                {
+                    var metricPluginId = context.getLong(APIConstants.ENTITY_ID);
+
+                    var metricPlugin = MetricPluginConfigStore.getStore().getItem(metricPluginId);
+
+                    if (metricPlugin != null && shouldUnprovisionMetric(object, metricPlugin))
+                    {
+                        metrics.add(new JsonObject().put(ID, metric.getLong(ID)));
+
+                        LOGGER.info(String.format("Unprovisioning metric %s from object %s due to removed tag/group assignment",
+                            metric.getString(Metric.METRIC_NAME), objectId));
+                    }
+                }
+            }
+
+            if (!metrics.isEmpty())
+            {
+                NMSConstants.updateMetrics(metrics, EventBusConstants.EVENT_METRIC_UNPROVISION).onComplete(result ->
+                {
+                    if (result.succeeded())
+                    {
+                        LOGGER.info(String.format("Successfully unprovisioned %d metrics for object %s",
+                            metrics.size(), objectId));
+                    }
+                    else
+                    {
+                        LOGGER.error(result.cause());
+                    }
+                    promise.complete();
+                });
+            }
+            else
+            {
+                promise.complete();
+            }
+        }
+        catch (Exception exception)
+        {
+            LOGGER.error(exception);
+
+            promise.complete();
+        }
+
+        return promise.future();
+    }
+
+    /**
+     * Determines if a metric should be unprovisioned based on removed tags/groups
+     */
+    private boolean shouldUnprovisionMetric(JsonObject object, JsonObject metricPlugin)
+    {
+        var entityType = metricPlugin.getString(MetricPlugin.METRIC_PLUGIN_ENTITY_TYPE);
+
+        var entities = metricPlugin.getJsonArray(MetricPlugin.METRIC_PLUGIN_ENTITIES);
+
+        if (entities == null || entities.isEmpty())
+        {
+            return false;
+        }
+
+        // Check if metric plugin was assigned via removed groups
+        if (APIConstants.Entity.GROUP.getName().equalsIgnoreCase(entityType))
+        {
+            var items = new HashSet<>(object.getJsonArray(AIOpsObject.OBJECT_GROUPS).getList());
+
+            for (var i = 0; i < entities.size(); i++)
+            {
+                if (items.contains(entities.getLong(i)))
+                {
+
+                    return false;
+                }
+            }
+        }
+        // Check if metric plugin was assigned via removed tags
+        else if (APIConstants.Entity.TAG.getName().equalsIgnoreCase(entityType))
+        {
+            var tagItems = TagConfigStore.getStore().getIdsByItems(entities);
+
+            var items = new HashSet<>(object.getJsonArray(AIOpsObject.OBJECT_TAGS).getList());
+
+            for (var i = 0; i < tagItems.size(); i++)
+            {
+                if (items.contains(tagItems.getInteger(i)))
+                {
+                    return false;
+                }
+            }
+        }
+
+        return true;
+    }
+
