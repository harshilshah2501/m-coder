# Example timer — run sync + graph refresh every 30 minutes (adjust OnCalendar).
#   sudo cp motadata-neo4j-sync.timer.example /etc/systemd/system/motadata-neo4j-sync.timer
#   sudo systemctl enable --now motadata-neo4j-sync.timer

[Unit]
Description=Timer for Motadata Neo4j sync + graph refresh

[Timer]
Unit=motadata-neo4j-sync.service
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
