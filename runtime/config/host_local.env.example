# m-coder — local host template (Context Layer + Plan-Gate + plugin URLs)
# Copy to host_local.env (gitignored) and adjust paths/ports for this machine.
#
#   cp runtime/config/host_local.env.example runtime/config/host_local.env
#
# Load before starting services or paste exports into your shell:
#   set -a && source runtime/config/host_local.env && set +a
#
# See: docs/validation/B5_HOST_READINESS.md

# Absolute path to this repository checkout (Context Layer indexes this tree)
M_CODER_REPO_ROOT=/ABSOLUTE/PATH/TO/m-coder

# --- Ports (defaults match plugin + validation sheet) ---
CONTEXT_LAYER_HOST=127.0.0.1
CONTEXT_LAYER_PORT=8091
PLAN_GATE_PORT=8089
VLLM_PORT=8000

# --- Derived URLs (JetBrains / curl; keep in sync with ports above) ---
export MOTADATA_CONTEXT_LAYER_URL="http://${CONTEXT_LAYER_HOST}:${CONTEXT_LAYER_PORT}"
export MOTADATA_PLAN_GATE_URL="http://127.0.0.1:${PLAN_GATE_PORT}"
# Validation sheet compatibility
export CONTEXT_URL="${MOTADATA_CONTEXT_LAYER_URL}"
export PLAN_GATE_URL="${MOTADATA_PLAN_GATE_URL}"
export VLLM_URL="http://127.0.0.1:${VLLM_PORT}"

# Workspace for HTTP validation (export_evidence); must match the repo Context Layer can read
export WORKSPACE_ROOT="${M_CODER_REPO_ROOT}"
