# Demo stack config for governed services (vLLM + Plan-Gate).
# Copy to demo_stack.env and set values. Launcher loads demo_stack.env from this directory.
# Used by runtime/scripts/governed_services.sh (start|stop|restart|status).
#
# Context Layer (separate process) uses runtime/config/host_local.env.example — same default ports:
#   CONTEXT_LAYER_PORT=8091   PLAN_GATE_PORT=8089   VLLM_PORT=8000
#
# REQUIRED — local path only (directory or file as used by vLLM on this host)
VLLM_BASE_MODEL=
#
# OPTIONAL
ADAPTER_PATH=
VLLM_SERVED_MODEL_NAME=motadata-coder
VLLM_PORT=8000
PLAN_GATE_PORT=8089
VLLM_VENV=
# Runtime must have a local copy of the repository. Plugin paths are not used for filesystem access.
ASK_DEFAULT_REPO_ROOT=
#
# Plan-Gate Ask narration (must live here or be exported before Plan-Gate starts — mcoder CLI shell alone is not enough).
# governed_services.sh defaults both to 0 when unset; set in demo_stack.env to enable on restart.
# MCODER_REASONING_SYNTHESIS_V1=1
# MCODER_GOVERNED_ASK_NARRATOR=1
#
# DERIVED (auto if empty; do not set unless overriding)
# MOTADATA_EXPLAIN_VLLM_URL=http://127.0.0.1:8000
# MOTADATA_EXPLAIN_MODEL=motadata-coder
