# Motadata AI System — legacy broad template (training/RAG paths may appear here).
# For m-coder governed HTTP stack (Plan-Gate, Context Layer, validation sheet), use:
#   runtime/config/host_local.env.example
#   runtime/config/demo_stack.env.example
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# ============================================================================
# PATHS
# ============================================================================
MOTADATA_ROOT=/home/harshil/Harshil-PoCs
VENV_TRAINING=$MOTADATA_ROOT/venv/training
VENV_VLLM=$MOTADATA_ROOT/venv/vllm
VENV_RAG=$MOTADATA_ROOT/venv/rag
MODEL_PATH=$MOTADATA_ROOT/models/v15/motadata-coder-v15-merged
RAG_SYSTEM_DIR=$MOTADATA_ROOT/rag
TRAINING_DIR=$MOTADATA_ROOT/training
EVALUATION_DIR=$MOTADATA_ROOT/evaluation

# ============================================================================
# SERVICE PORTS
# ============================================================================
VLLM_PORT=8000
API_WRAPPER_PORT=8080
RAG_API_PORT=8081
QDRANT_PORT=6333

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_DIR=$MOTADATA_ROOT/logs

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Version-agnostic model name used by all services (RAG API, Coder Agent, etc.)
VLLM_MODEL_NAME=motadata-coder
# Version-specific information (for reference only, not used by services)
MODEL_VERSION=v16
DTYPE=bfloat16
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.95

# ============================================================================
# RAG CONFIGURATION
# ============================================================================
EMBEDDING_MODEL=jina-embeddings-v2-base-code
EMBEDDING_DIM=768
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================
BATCH_SIZE=4
LEARNING_RATE=2e-5
NUM_EPOCHS=3
WARMUP_STEPS=100

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
DOCKER_COMPOSE_FILE=$RAG_SYSTEM_DIR/docker/docker-compose.yml
QDRANT_IMAGE=qdrant/qdrant:latest

