{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingestion_batch.v0.1",
  "title": "Ingestion Batch v0.1",
  "description": "Batch of plan+ledger+decision for observation ingestion.",
  "type": "object",
  "required": ["schema_version", "batch_id", "created_utc", "source", "items"],
  "properties": {
    "schema_version": {"const": "ingestion_batch.v0.1"},
    "batch_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["component", "host"],
      "properties": {"component": {"type": "string", "enum": ["runtime_plan_gate", "ide_plugin", "other"]}, "host": {"type": "string"}}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "plan", "ledger_row"],
        "properties": {
          "request_id": {"type": "string"},
          "plan": {"type": "object"},
          "ledger_row": {"type": "object"},
          "decision_response": {"type": "object"},
          "lineage_refs": {
            "type": "object",
            "properties": {"base_id": {"type": "string"}, "variant_id": {"type": "string"}, "boundary_phrase_hash": {"type": "string"}, "freeze_version_id": {"type": "string"}, "model_artifact_id": {"type": "string"}}
          }
        }
      }
    }
  }
}
