{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteRequest v0.1",
  "description": "M3.4 IDE Plugin execution request. Routes through Plan-Gate before sandbox.",
  "type": "object",
  "required": ["request_id", "repo_root", "command"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "execute_request.v0.1"
    },
    "request_id": {
      "type": "string",
      "description": "Unique request identifier for tracing"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Request creation timestamp in ISO-8601 UTC"
    },
    "repo_root": {
      "type": "string",
      "description": "Repository root path"
    },
    "revision": {
      "type": "string",
      "description": "Git revision / commit SHA"
    },
    "branch": {
      "type": "string",
      "description": "Git branch name"
    },
    "command": {
      "type": "string",
      "description": "Command or action to execute"
    },
    "task_id": {
      "type": "string",
      "description": "Optional task ID for multi-step workflows"
    },
    "plan_hash": {
      "type": "string",
      "description": "Plan hash if this relates to a prior plan"
    },
    "ide_context": {
      "type": "object",
      "description": "IDE context metadata",
      "properties": {
        "product": { "type": "string" },
        "ide": { "type": "string" },
        "project": { "type": "string" },
        "user": { "type": "string" }
      }
    },
    "client_policy": {
      "type": "object",
      "description": "Client policy for execution",
      "properties": {
        "fail_closed_if_gate_unreachable": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["shadow", "enforcing"] }
      }
    }
  }
}
