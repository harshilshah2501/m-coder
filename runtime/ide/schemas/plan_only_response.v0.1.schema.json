{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan_only_response.v0.1",
  "title": "Plan-Only Response v0.1",
  "description": "Runtime -> plugin plan-only response for repo-aware ask.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "timestamp_utc",
    "context_bundle",
    "plan_summary",
    "governance_posture",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "plan_only_response.v0.1"
    },
    "request_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "context_bundle": {
      "type": "object",
      "required": [
        "revision",
        "files",
        "selectors_used"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "selection_reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "selection_reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "selectors_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "plan_summary": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "governance_posture": {
      "type": "string",
      "enum": ["PLAN_ONLY"]
    },
    "execution": {
      "type": "boolean",
      "const": false
    },
    "ui": {
      "type": "object",
      "required": [
        "title",
        "message",
        "severity"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning"]
        }
      },
      "additionalProperties": false
    },
    "explain_debug": {
      "type": "object",
      "description": "Present when task_type was EXPLAIN_DEBUG; contains real reasoning or error.",
      "properties": {
        "summary": { "type": "string" },
        "logic_flow": { "type": "string" },
        "likely_bug_risk": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence_limits": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "context_resolution": {
      "type": "object",
      "description": "Present when server used ASK_DEFAULT_REPO_ROOT because requested repo_root was invalid on server.",
      "properties": {
        "requested_repo_root": { "type": "string" },
        "effective_repo_root": { "type": "string" },
        "fallback_used": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence_bundle": {
      "type": "object",
      "description": "layer5.evidence_bundle.v1 JSON when evidence_first path succeeded (opaque; validate with L5 schema).",
      "additionalProperties": true
    },
    "evidence_first_meta": {
      "type": "object",
      "description": "Whether Layer-5 evidence path was used or legacy ContextEngine fallback.",
      "additionalProperties": true
    },
    "routing_mode": {
      "type": "string",
      "enum": ["plan_only", "explain_debug"],
      "description": "Which handler branch produced the plan: template planner vs explain_debug (vLLM)."
    },
    "trace_id": {
      "type": "string",
      "description": "Echo of ask_request.trace_id when provided, for log/response correlation."
    },
    "assist_layer": {
      "type": "object",
      "description": "Optional Assist Layer v1 advisory metadata; non-authoritative and additive.",
      "required": [
        "request_id",
        "trace_id",
        "original_query",
        "augmented_query",
        "reason",
        "suggestions",
        "confidence_enum",
        "assist_status",
        "transform_codes_applied",
        "suggestion_sources",
        "errors"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "original_query": { "type": "string" },
        "augmented_query": { "type": "string" },
        "reason": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence_enum": {
          "type": "string",
          "enum": ["none", "low", "medium"]
        },
        "assist_status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded_empty_context",
            "input_invalid",
            "timeout_or_internal_error",
            "blocked_by_policy"
          ]
        },
        "transform_codes_applied": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestion_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["user_input", "context_meta", "static_template"]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "retrieval_drift_validation": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "plan_contract": {
      "type": "object",
      "description": "Optional additive governed plan artifact; present only when explicitly requested via response_extensions and truthfully generated.",
      "required": ["schema_version"],
      "properties": {
        "schema_version": {
          "const": "plan_contract.v1"
        }
      },
      "additionalProperties": true
    },
    "code_reasoning_trace": {
      "type": "object",
      "description": "Optional additive code reasoning trace artifact; emitted only for explicit opt-in with valid plan_contract dependency.",
      "required": ["schema_version"],
      "properties": {
        "schema_version": {
          "const": "code_reasoning_trace.v1"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

