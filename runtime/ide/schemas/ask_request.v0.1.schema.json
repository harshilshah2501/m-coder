{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ask_request.v0.1",
  "title": "Ask Request v0.1",
  "description": "Plugin -> runtime repo-aware ask request.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "timestamp_utc",
    "repo_root",
    "revision",
    "query"
  ],
  "properties": {
    "schema_version": {
      "const": "ask_request.v0.1"
    },
    "request_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repo_root": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "selected_file": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "client_context": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

