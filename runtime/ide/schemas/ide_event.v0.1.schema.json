{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ide_event.v0.1",
  "title": "IDE Event v0.1",
  "description": "Event captured by plugin before plan-gate.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp_utc",
    "ide_context",
    "action"
  ],
  "properties": {
    "schema_version": {
      "const": "ide_event.v0.1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ide_context": {
      "type": "object",
      "required": [
        "product",
        "ide",
        "project",
        "repo_root",
        "branch",
        "user"
      ],
      "properties": {
        "product": {
          "const": "jetbrains"
        },
        "ide": {
          "type": "string",
          "enum": [
            "intellij",
            "pycharm",
            "goland",
            "webstorm",
            "clion",
            "other"
          ]
        },
        "project": {
          "type": "string"
        },
        "repo_root": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_type",
        "target"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": [
            "PR_MERGE",
            "CONFIG_CHANGE",
            "DEPLOY_INTENT",
            "PROD_WRITE_INTENT",
            "OTHER"
          ]
        },
        "target": {
          "type": "string"
        },
        "diff_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_touched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_excerpt": {
          "type": "string"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ticket",
              "pr",
              "commit",
              "doc",
              "url"
            ]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    }
  }
}