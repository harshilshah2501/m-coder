{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolExecutionRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_name",
    "args",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "tool_execution_request.v1"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "object"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "sandbox_required",
        "read_only"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "sandbox_required": {
          "type": "boolean",
          "const": true
        },
        "read_only": {
          "type": "boolean"
        }
      }
    }
  }
}
