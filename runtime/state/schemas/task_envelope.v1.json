{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskEnvelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_type",
    "constraints",
    "evidence_bundle",
    "attempt_budget",
    "tool_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "task_envelope.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "enum": [
        "ASK",
        "DEBUG",
        "PLAN",
        "CODE",
        "EXECUTE"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_repo_access_from_gpu",
        "no_silent_fallback",
        "runtime_controls_loop",
        "no_reretrieval_inside_loop"
      ],
      "properties": {
        "no_repo_access_from_gpu": {
          "type": "boolean",
          "const": true
        },
        "no_silent_fallback": {
          "type": "boolean",
          "const": true
        },
        "runtime_controls_loop": {
          "type": "boolean",
          "const": true
        },
        "no_reretrieval_inside_loop": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "workspace_identity_hash",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "layer5.evidence_bundle.v1"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_identity_hash": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "attempt_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "remaining_attempts"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "remaining_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "mode"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "sandboxed"
          ]
        },
        "plan_gate_recheck_required": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
