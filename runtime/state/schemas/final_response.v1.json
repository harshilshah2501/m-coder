{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinalResponse.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "evidence_used",
    "evidence_refs",
    "reasoning_summary",
    "execution_result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "final_response.v1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "refused",
        "blocked",
        "failed",
        "insufficient"
      ]
    },
    "evidence_used": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "item_count"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proposal_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tool_result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "executed",
            "blocked",
            "failed"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
