{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopContextFrame.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "iteration_index",
    "remaining_budget",
    "current_state",
    "evidence_refs",
    "rejection_reasons",
    "policy_snapshot",
    "task_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "loop_context_frame.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "iteration_index": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "current_state": {
      "type": "string",
      "enum": [
        "CONTEXT_READY",
        "PLAN_GATED",
        "MODEL_PROPOSED",
        "PROPOSAL_VALIDATED",
        "TOOL_EXECUTING",
        "TOOL_RESULT_READY",
        "MODEL_REVISED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "previous_proposal_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_tool_result_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_mode",
        "allowed_tools",
        "plan_gate_recheck_required"
      ],
      "properties": {
        "tool_mode": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "sandboxed"
          ]
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "plan_gate_recheck_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "task_type": {
      "type": "string",
      "enum": [
        "ASK",
        "DEBUG",
        "PLAN",
        "CODE",
        "EXECUTE"
      ]
    }
  }
}
