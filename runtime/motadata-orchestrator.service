[Unit]
Description=Motadata AI Services Orchestrator
Documentation=file:///home/harshil/Harshil-PoCs/IMPLEMENTATION_SUMMARY.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=forking
User=harshil
Group=harshil
WorkingDirectory=/home/harshil/Harshil-PoCs

# Set up environment with proper PATH and SSH key
Environment="PATH=/home/harshil/Harshil-PoCs/venv/vllm/bin:/home/harshil/Harshil-PoCs/venv/rag/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="HOME=/home/harshil"

# Start the orchestrator (runs as harshil user with sudoers passwordless access)
ExecStart=/bin/bash /home/harshil/Harshil-PoCs/rag/scripts/orchestrator_unified.sh start

# Stop all services gracefully
ExecStop=/bin/bash /home/harshil/Harshil-PoCs/rag/scripts/orchestrator_unified.sh stop

# Restart on failure
Restart=on-failure
RestartSec=10

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=motadata-orchestrator

[Install]
WantedBy=multi-user.target

