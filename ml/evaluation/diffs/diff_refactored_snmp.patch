+    private Future<Void> updateProfile(HashMap<Long, ArrayList<Long>> usersByProfile)
+    {
+        var promise = Promise.<Void>promise();
+
+        try
+        {
+            var futures = new ArrayList<Future<Void>>();
+
+            if (usersByProfile != null)
+            {
+                usersByProfile.keySet().forEach(profileId ->
+                {
+                    var future = Promise.<Void>promise();
+
+                    try
+                    {
+                        futures.add(future.future());
+
+                        var users = usersByProfile.get(profileId);
+
+                        var profile = UserProfileConfigStore.getStore().getItem(profileId);
+
+                        var profileUsers = profile.getJsonArray(USER_PROFILE_USERS);
+
+                        for (var user : users)
+                        {
+                            profileUsers.remove(user);
+                        }
+
+                        LOGGER.info(String.format("old profile users : %s", profileUsers.encode()));
+
+                        Bootstrap.configDBService().update(DBConstants.TBL_USER_PROFILE,
+                                new JsonObject().put(DBConstants.FIELD_NAME, ID).put(VALUE, profileId),
+                                new JsonObject().put(USER_PROFILE_USERS, profileUsers),
+                                DEFAULT_USER,
+                                SYSTEM_REMOTE_ADDRESS, futureResult -> UserProfileConfigStore.getStore().updateItem(profileId).onComplete(asyncFutureResult -> future.complete()));
+                    }
+                    catch (Exception exception)
+                    {
+                        LOGGER.error(exception);
+
+                        future.fail(exception);
+                    }
+                });
+            }
+
+            Future.join(futures).onComplete(result -> promise.complete());
+        }
+        catch (Exception exception)
+        {
+            LOGGER.error(exception);
+
+            promise.fail(exception);
+        }
+
+        return promise.future();
+    }
+
