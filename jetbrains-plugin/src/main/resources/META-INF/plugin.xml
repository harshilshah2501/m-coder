<idea-plugin>
    <id>ai.motadata.runtime-plugin</id>
    <name>Motadata Runtime Governance (MVP)</name>
    <version>0.1.0</version>
    <vendor email="dev@motadata.ai">Motadata</vendor>

    <description>
        Minimal JetBrains plugin MVP that intercepts VCS commits, sends PlanRequest v0.1
        to the local Plan-Gate service, and surfaces shadow-mode decisions as
        "would block / would conditionally block / would allow" notifications.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <checkinHandlerFactory implementation="ai.motadata.plugin.vcs.MotadataCheckinHandlerFactory"/>
        <notificationGroup id="Motadata AI" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="ai.motadata.plugin.actions.AskMotadataAiAction"
                class="ai.motadata.plugin.ask.AskMotadataAiAction"
                text="Ask Motadata AI"
                description="Repo-aware Ask / Safe Planning (PLAN ONLY)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

