      "require_owner_in_top3": true,
      "min_anchor_hit_rate_top_k": 0.5,
      "max_generic_infra_ratio_top_k": 0.6
    },
    "ask_mail_server_configuration": {
      "enforce": true,
      "require_owner_in_top3": true,
      "min_anchor_hit_rate_top_k": 0.5,
      "max_generic_infra_ratio_top_k": 0.6
    },
    "ask_config_store_organization": {
      "enforce": true,
      "require_owner_in_top3": true,
      "min_anchor_hit_rate_top_k": 0.5,
      "max_generic_infra_ratio_top_k": 0.6
    },
    "ask_api_layer_architecture": {
      "enforce": true,
      "require_owner_in_top3": true,
      "max_generic_infra_ratio_top_k": 0.7
    },
    "ask_notification_handlers": {
      "enforce": true,
      "max_distractor_count_top_k": 1,
      "max_generic_infra_ratio_top_k": 0.65,
      "require_owner_in_top3": true
    }
  }
