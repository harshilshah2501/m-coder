{
  "schema_version": "motadata_aiops_behavior_scenarios.v1",
  "description": "Deterministic expectations for Motadata AIOps behavior verification. Paths and queries align with docs/guides/MOTADATA_AIOPS_PRODUCTION_VERIFICATION_GUIDE.md.",
  "defaults": {
    "top_k": 8
  },
  "scenarios": [
    {
      "id": "ask_broad_correlation",
      "capability": "ask",
      "description": "Broad repo question: plan-only answer with v1 evidence path",
      "query": "How does alert correlation and enrichment work?",
      "requires_behavior_flow": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1
      }
    },
    {
      "id": "ask_symbol_anchored",
      "capability": "ask",
      "description": "Anchored question: expect correlation engine in plan or evidence",
      "query": "Where is alert correlation implemented? Reference AvailabilityCorrelationEngine or AlertCorrelationEngine.",
      "must_cite_file_or_symbol_anchor": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "ask_path": "v1_evidence",
        "min_plan_steps": 1,
        "text_contains_any": [
          "AvailabilityCorrelationEngine",
          "AlertCorrelationEngine",
          "correlation"
        ]
      }
    },
    {
      "id": "ask_anchor_owner_gate",
      "capability": "ask",
      "description": "Pinned anchored owner query (registry class + product terms): authority primary owner must resolve, Stage A must inject owner lane, owner file must appear in export evidence top-3. Record evidence.workspace_identity_hash with your m-coder git SHA when filing regressions.",
      "query": "Explain AlertCorrelationEngine behavior for alert correlation in the product.",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1,
        "require_authority_primary_owner": true,
        "require_owner_in_top3": true,
        "require_stage_a_owner_injected_min": 1
      }
    },
    {
      "id": "ask_anchor_owner_top1",
      "capability": "ask",
      "description": "Strict anchored owner query: owner should rank top-1 under policy.",
      "query": "Where is alert correlation implemented? Focus on AvailabilityCorrelationEngine.start.",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1,
        "require_authority_primary_owner": true,
        "require_owner_in_top3": true,
        "require_authority_status": "validated",
        "text_contains_any": [
          "AvailabilityCorrelationEngine",
          "start",
          "correlation"
        ]
      }
    },
    {
      "id": "ask_api_request_routing_owner",
      "capability": "ask",
      "description": "API request routing should anchor to APIServer ownership.",
      "query": "Where is API request routing handled in Motadata?",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1,
        "require_authority_primary_owner": true,
        "text_contains_any": [
          "APIServer",
          "api",
          "routing"
        ]
      }
    },
    {
      "id": "ask_servicenow_sync_owner",
      "capability": "ask",
      "description": "ServiceNow sync query should anchor to integration owner.",
      "query": "Where is ServiceNow incident synchronization implemented?",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1,
        "require_authority_primary_owner": true,
        "text_contains_any": [
          "ServiceNowIntegration",
          "integration",
          "sync"
        ]
      }
    },
    {
      "id": "ask_mail_config_domain",
      "capability": "ask",
      "description": "Mail config domain query must be anchored to concrete implementation paths/symbols.",
      "query": "Where is mail configuration domain handling implemented in Motadata?",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "forbid_generic_scan_answer": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1
      }
    },
    {
      "id": "ask_config_store_organization",
      "capability": "ask",
      "description": "Config-store organization query must be anchored to concrete implementation paths/symbols.",
      "query": "Where is configuration store organization implemented in Motadata?",
      "requires_graph_path": true,
      "must_cite_file_or_symbol_anchor": true,
      "forbid_generic_scan_answer": true,
      "expect": {
        "governance_posture": "PLAN_ONLY",
        "execution": false,
        "ask_path": "v1_evidence",
        "min_plan_steps": 1
      }
    },
    {
      "id": "debug_explain_selection",
      "capability": "debug",
      "description": "EXPLAIN_DEBUG with explicit file + selection",
      "query": "How does alert correlation and enrichment work?",
      "debug_query": "Debug why incident enrichment might be skipped for some events",
      "selected_file": "motadata/src/main/java/com/mindarray/aiops/AvailabilityCorrelationEngine.java",
      "selection": "Trace enrichment and correlation paths; list likely failure points.",
      "requires_selected_file_binding": true,
      "expect": {
        "routing_mode": "explain_debug",
        "explain_debug_has_keys": ["summary", "evidence", "confidence_limits"],
        "must_reference_selected_file_or_symbol": true,
        "require_selected_file_in_evidence": true,
        "must_suggest_concrete_failure_points": true,
        "must_have_confidence_limits": true,
        "required_text_contains_any": [
          "AvailabilityCorrelationEngine",
          "branch",
          "method"
        ]
      }
    },
    {
      "id": "debug_explain_missing_selected_file",
      "capability": "debug",
      "description": "EXPLAIN_DEBUG reports truthful insufficiency when selected file is absent",
      "query": "Why might enrichment be skipped?",
      "debug_query": "Explain failure points for a file that is not in retrieved context",
      "selected_file": "motadata/src/main/java/com/mindarray/aiops/doesnotexist/MissingEngine.java",
      "selection": "Trace branch and enrichment behavior.",
      "requires_selected_file_binding": true,
      "expect": {
        "routing_mode": "explain_debug",
        "explain_debug_has_keys": ["summary", "evidence", "confidence_limits"],
        "must_have_confidence_limits": true,
        "require_insufficient_grounding": true,
        "require_missing_in_context_marker": true,
        "required_text_contains_any": [
          "insufficient",
          "missing_in_context"
        ]
      }
    },
    {
      "id": "plan_pr_merge_shadow",
      "capability": "plan",
      "description": "Governed PR merge decision (shadow)",
      "requires_playbook": true,
      "expect": {
        "schema_version": "decision_response.v0.1",
        "decision_present": true
      }
    }
  ]
}
