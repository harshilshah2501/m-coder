[Unit]
Description=Motadata AI Services Orchestrator (Unified) - Manages vLLM, API Wrapper, RAG API, and Health Monitor
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=harshil
Group=harshil
WorkingDirectory=/home/harshil/Harshil-PoCs/rag

# Start the orchestrator
ExecStart=/home/harshil/Harshil-PoCs/rag/scripts/orchestrator_unified.sh start

# Stop the orchestrator
ExecStop=/home/harshil/Harshil-PoCs/rag/scripts/orchestrator_unified.sh stop

# Restart policy
Restart=always
RestartSec=10

# Give enough time for vLLM to load (180s) + buffer
TimeoutStartSec=300
TimeoutStopSec=60

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

